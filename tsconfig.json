{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@/assets/*": [
        "./assets/*"
      ],
      "@cardiani/types": [
        "./lib/types/index.ts"
      ],
      "@cardiani/types/*": [
        "./lib/types/*"
      ],
      "@cardiani/api-client": [
        "./lib/api-client/index.ts"
      ],
      "@cardiani/api-client/*": [
        "./lib/api-client/*"
      ],
      "@cardiani/shared": [
        "./src/shared/index.ts"
      ],
      "@cardiani/shared/*": [
        "./src/shared/*"
      ],
      "@cardiani/i18n": [
        "./src/i18n-pkg/index.ts"
      ],
      "@cardiani/i18n/*": [
        "./src/i18n-pkg/*"
      ]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "lib/**/*.ts",
    "lib/**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ]
}
