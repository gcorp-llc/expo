{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@/assets/*": [
        "./assets/*"
      ],
      "@cardiani/types": [
        "./lib/types/index.ts"
      ],
      "@cardiani/types/*": [
        "./lib/types/*"
      ],
      "@cardiani/api-client": [
        "./lib/api-client/index.ts"
      ],
      "@cardiani/api-client/*": [
        "./lib/api-client/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ]
}
