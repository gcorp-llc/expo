# ==============================================================================
# CARDIANI CLIENT ENVIRONMENT VARIABLES (EXPO PUBLIC)
# Note: Never put secret keys (such as Supabase service_role, Stripe secret) here!
# ==============================================================================

# Backend API Base URL (For physical device use LAN IP, for emulator 10.0.2.2)
EXPO_PUBLIC_API_URL=http://10.0.2.2:4000

# Supabase (Public Client Keys only)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.example

# Stripe (Publishable Key only)
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_51...

# Sentry DSN
EXPO_PUBLIC_SENTRY_DSN=https://example@sentry.io/1234567

# Optional App Environment indicator: development | preview | production
APP_ENV=development
