# Cardiani Mobile - Environment Variables

# Backend Base API URL
# Default fallback: http://localhost:8080 or http://10.0.2.2:8080
# Note: On Android Emulator, 'localhost' refers to the emulator itself. Use '10.0.2.2' to connect to host backend.
# On physical devices, use your local network IP (e.g., http://192.168.1.100:8080).
EXPO_PUBLIC_API_URL=http://localhost:8080/api/v1

# Realtime WebSocket Gateway URL
EXPO_PUBLIC_WS_URL=ws://localhost:8080/v1/ws

# Optional Sentry DSN for Error Monitoring
# EXPO_PUBLIC_SENTRY_DSN=https://your-sentry-dsn.ingest.sentry.io/project-id

# Optional Stripe Publishable Key for Payments
# EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_sample
